# Port to run the simulator dashboard web server on (default: 3000)
PORT=3000
INSTANCE_NAME=instance_1
TOTAL_INSTANCES=4
DASHBOARD_PASSWORD=Ankitsin

# Option A: Render PostgreSQL or local PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5472/dbname

# Option B: MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Option C: Supabase configuration
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-key

# Initial configuration to seed the database if it is empty (JSON string)
# INITIAL_CONFIG='[{"name":"client_primary","refreshToken":"your_refresh_token_here","scale":10}]'
